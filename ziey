function Auto.treeTableOk(t)
    local w = Refs.World
    if type(t) ~= _dvfvr("HQkOBAE=") or t == w or getmetatable(t) ~= nil or rawget(t, _dvfvr("Dw8=")) ~= nil then return false end
    local n = 0
