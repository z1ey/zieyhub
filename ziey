    end
    d.taking = false
    pool.busy = math.max(0, pool.busy - 1)
    if d.id ~= (221 - 109) then pool.room[d.id] = math.max(0, (pool.room[d.id] or 0) - amount) end
    if Refs.World ~= world or Refs.Inv ~= inventory or not world or world.fg ~= grid then return false end

    if not (ok and type(taken) == _dvfvr("Bx0BCgEX") and taken > 0 and taken <= amount) then
        State.CollectFail = State.CollectFail + 1
        Drops.fail(ok and _dvfvr("OQ0CDwUIAQ0BFgZMDRoDGEQBChACGwkHSUdMCgEJFglNEwEHBgYKARYIAhcEVxsJGx4JGg==")
            or (_dvfvr("LgkLCQhFAgkPHgRMDRoDGF5F") .. string.sub(tostring(taken), 1, (309 - 129))))
        d.refused = os.clock() -- tanda ditolak, sama seperti game
        d.failN = (d.failN or 0) + 1
        DropFailUntil[d.uid] = os.clock() + math.min((16 - 8), d.failN) -- 1, 2, 3.. detik (yang terus ditolak makin jarang)
        d.flown = nil
        if typeof(d.frame) == _dvfvr("IAYfHAULAAE=") then pcall(function() d.frame.Visible = not d.culled end) end
        return false
    end
    DropFailUntil[d.uid] = nil

