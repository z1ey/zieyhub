                Pabrik.Status = nReady .. _dvfvr("SRgDAAsLQxcEFhhMCw0AHQlFFwEfHQkCDgMNHUhFBw0OGAoNSQQNDw0=")
            elseif seeds <= 0 and blocks <= 0 and (o.takePending or o.takeUnreadable) then
                Pabrik.Status = o.takeStatus or _dvfvr("JA0CHQoCBBFNFQQDCgNMAAUWCghNBwkCDAZMEQULBEQPHhsNSQwFCQkHCgg=")
            elseif nextReady then
                Pabrik.Status = _dvfvr("JA0CHQoCBBFNBwcEBgZMGw0EE0Tc") .. waitText(nextReady)
            elseif blocks > 0 and (Pabrik.BreakX < 0 or next(Pabrik.Tiles) == nil) then
                Pabrik.Status = _dvfvr("KAwNSAYJDAcGVxwNGQFMGAsWChcEV0dMHQEADUQHEQEMHEgODAQZBUQBCgUZAho=")
