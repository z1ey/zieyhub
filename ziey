local function itemName(id)
    local it = ItemDB[id]
    return (it and it.name) or (_dvfvr("IBwJBURG") .. tostring(id))
end

local function invCount(id)
    if not Refs.Inv then return 0 end
    local ok, n = pcall(function() return Refs.Inv:count(id) end)
    n = ok and tonumber(n) or nil
    if n and n >= 0 and n < math.huge then return n end
    local total = 0
    for _, slot in ipairs(Refs.inventoryEntries()) do
        if slot.id == tonumber(id) then total = total + slot.n end
    end
    return total
end

local function isPlaceable(id)
    local it = ItemDB[id]
    if not it then return false end
    if it.kind == _dvfvr("HQcDBA==") or it.kind == _dvfvr("CgQDHAw=") or it.kind == _dvfvr("CgQDHAwAEA==") or it.kind == _dvfvr("CgcCGxEIAgYBEg==") then
        return false
    end
    if it.lock or it.area then return false end
    return true
end

local function placeableIds()
    local ids, seen = {}, {}
    for _, slot in ipairs(Refs.inventoryEntries()) do
        if not seen[slot.id] and isPlaceable(slot.id) then
            seen[slot.id] = true
            ids[#ids + 1] = slot.id
        end
    end
    table.sort(ids)
    return ids
end

local function inventoryLabels(ids)
    local out = {}
    for _, id in ipairs(ids or placeableIds()) do
        out[#out + 1] = string.format(_dvfvr("TBtMM0EBPg=="), itemName(id), id)
    end
    if #out == 0 then out = { _dvfvr("QQECHgELFwsfHkgHBhsDBgNFTEQPEgQZBEgYDRYHAgcMXg==") } end
    return out
end

