local function sendNextChat()
    if #Spam.Texts == 0 then
        Spam.Last = _dvfvr("LQkKHAUXQxQIBAkCSQMDGwsLBA==")
        return false
    end
    local ch = worldChannel()
    if not ch then
        Spam.Last = _dvfvr("KgANBgoAD0QOHwkYSR8DGggBQwYIGx0BSQkICURNDgUeAgNMHgceBABFBxEBAkE=")
        return false
    end
    if Spam.Index > #Spam.Texts then Spam.Index = 1 end
    local msg = Spam.Texts[Spam.Index]
    Spam.Index = Spam.Index % #Spam.Texts + 1
    local ok, err = pcall(ch.SendAsync, ch, msg)
    if ok then
        Spam.Sent += 1
        Spam.Last = msg
    else
        Spam.Last = _dvfvr("LgkLCQhfQw==") .. tostring(err)
    end
    return ok
end

