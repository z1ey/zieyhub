local function buildLoop(runId)
    local function live() return Build.Running and alive() and Build.RunId == runId end
    local seed = seedOfBlock(Build.BlockId)
    local o = { seed = seed, block = Build.BlockId, live = live }
    local phase = nil
    local noneAt = nil
    while live() do
        task.wait()
        local P = Build.plan()
        if not P then
            Build.stop(_dvfvr("PQEICQ9FAgAMVwoNGwEfSCAMERBNMQkeBEhECwEOQzxNFh8NBUhDSDxFAg8FHhpMRkg1SAYEEQ0eVwkYCBtF"))
            break
        end
        Build.ActivePlan = P
        if Build.lavaStep(P, live) then continue end
        if Build.Surface == nil then Build.Surface = Build.findSurface(P) end
        local carve = Build.carveList(P)
        local info = landInfo(Build.BlockId, P, carve)
        Build.Info = info
        Build.InfoAt = os.clock()

        -- 1) GALI dulu sampai bawah
        local r = _dvfvr("BwcCDQ==")
        if #carve > 0 then
            Build.Reserve = 0
            Build.Phase = (_dvfvr("LgkAAV5FEA0eFkhJDUgYAQgA")):format(#carve)
            r = Build.carveStep(P, carve, live)
            if r ~= _dvfvr("BwcCDQ==") then noneAt = nil end
        end
        if r == _dvfvr("BwcCDQ==") and #carve == 0 and not o.dugSwept then
            -- Ambil bahan hanya jika kurang. Jangan menyusuri seluruh world
            -- lalu kembali ke awal sebelum pemasangan yang sebenarnya sudah bisa jalan.
            o.dugSwept, o.sweptAt = true, os.clock()
            if invCount(Build.BlockId) < info.need then
                Build.Phase = _dvfvr("KAUOAQhFAQgCFANMGgEfCUQCAggEFgZMEAkCD0QIAhcEH0gIAAoZHBENCAUD")
                Build.sweep(P, live, { [Build.BlockId] = true }, (33 - 3))
            end
            continue
        end
        if r == _dvfvr("BwcCDQ==") then
            local have = invCount(Build.BlockId)
            if info.need == 0 then
                -- tinggal tile gali yang dilewati: coba lagi sebentar
                if #carve > 0 then
                    noneAt = noneAt or os.clock()
                    local waited = os.clock() - noneAt
                    if waited < (81 - 36) then
                        Build.Status = #carve .. _dvfvr("SRwFBAFFBAUBHkgODAQZBUQRBhYHFgYLAgkZREQBCgcCFQlMBQkLAQ==")
                        if waited > (24 - 4) and not o.carveReset then
                            o.carveReset = true
                            table.clear(Build.Skip)
                            table.clear(BuildFail)
                            table.clear(BadEdge)
                            Reach = nil
                        end
                        if not waitAuto((1433 - 433)) then break end
                        continue
                    end
                end
                -- 4) BERSIH: ambil semua drop yang tertinggal di lahan
                Build.Phase = _dvfvr("Kw0eGw0NCAUDVwweBhhMDA1FJw0fA0gqCBoBSEwVBhZNFQkeABtF")
                Build.sweep(P, live, nil, (107 - 17))
                if not live() then break end
                if Build.lavaTarget(P) then continue end
                local note = (#carve > 0) and (_dvfvr("RUg=") .. #carve .. _dvfvr("SRwFBAFFBAUBHkgIAAQJHwURCg==")) or ""
                Build.stop(_dvfvr("LQEeHEQjAhYAVxsJBQ0fCQ1FSw==") .. info.done .. _dvfvr("SQoABwcO") .. note .. _dvfvr("QA=="))
                if Build.ThenPabrik then
                    if not Pabrik.SeedId then Pabrik.SeedId = seed end
                    Pabrik.start()
                end
                break
            end
            local reserve = (have >= info.need or not seed) and 0 or Build.RESERVE
            if phase ~= _dvfvr("GRoDDBEOEA0=") and have > reserve then
                -- 2) PASANG (sisakan block untuk produksi kalau masih kurang)
                phase = _dvfvr("GQkfCQoC")
                Build.Reserve = reserve
                Build.Phase = (_dvfvr("OQkfCQoCQyAEBRxMLwkeBV5FEA0eFkhJDUgYAQgA")):format(info.need)
                    .. ((reserve > 0) and (_dvfvr("SUAfARcECAUDVw==") .. reserve .. _dvfvr("SQoABwcOSg==")) or "")
                local pr = Build.placeStep(P)
                if pr == _dvfvr("BwcCDQ==") and invCount(Build.BlockId) > reserve then
                    Build.Status = _dvfvr("OgEfCUQRCggIVwoJBR0BSBAAEQ4MGQ8HCB1MR0QRBhYFFgQNBw9ASAAMAAsPFkgACA8F")
                    noneAt = noneAt or os.clock()
                    if os.clock() - noneAt > (37 - 17) then -- lama tidak ada yang bisa dipasang: reset & coba lagi
                        noneAt = nil
                        table.clear(Build.Skip)
                        table.clear(BuildFail)
                        table.clear(BadEdge)
                        table.clear(Build.Under)
                        Reach = nil
                    end
                    if not waitAuto((1836 - 336)) then break end
                elseif pr ~= _dvfvr("BwcCDQ==") then
                    noneAt = nil
                end
            elseif not seed then
                Build.stop((_dvfvr("KwQDCw9FCwUPHhtASQUNGw0NQw8YBQkCDkhJDERNEAEIE0UCEAlMHA0BAg9NHA0YDAUZQQ==")):format(info.need))
                break
            else
                -- 3) PRODUKSI
                if phase ~= _dvfvr("GRoDDBEOEA0=") then
                    if os.clock() - (o.sweptAt or -1e9) > (142 - 22) then
                        -- ambil dulu drop yang tertinggal di lahan (block, seed & lainnya), per baris
                        o.sweptAt = os.clock()
                        Build.Phase = _dvfvr("KAUOAQhFBxYCB0gfABsNSAAMQyAEBRxMLwkeBURNEwEfVwoNGwEfQQ==")
                        Build.sweep(P, live, { [Build.BlockId] = true }, (60 - 30))
                        continue
                    end
                    phase = _dvfvr("GRoDDBEOEA0=")
                    o.phase, o.rowK = nil, nil
                    notify(_dvfvr("KwkCDxELQyAEBRxMLwkeBQ=="), _dvfvr("KwQDCw9FCwUPHhtASRgeBwAQCBcEV1lMCwkeARdFBxEBAg=="), (6 - 2))
                end
                local target = math.min(CAP, info.need + Build.RESERVE)
                if have >= target then
                    phase = _dvfvr("GQkfCQoC")
                    notify(_dvfvr("KwkCDxELQyAEBRxMLwkeBQ=="), _dvfvr("KwQDCw9FABEGAhhMQQ==") .. have .. _dvfvr("QERMBAULCREZVxgNGgkCDw=="), (7 - 3))
                else
                    if o.rowK and not P.rows[o.rowK] then o.rowK = nil end
                    if o.rowK == nil then
                        o.rowK = Build.prodRow(P) or false
                        table.clear(Build.Row)
                        if o.rowK then
                            local sp = Build.prodSpots(P, o.rowK)
                            o.plantSet, o.stand, o.tile, o.exclude = sp.set, sp.stand, sp.tile, nil
                        else -- belum ada baris lengkap: tanam di mana saja di luar tile lahan
                            o.plantSet, o.stand, o.tile, o.exclude = nil, nil, nil, landBlockSet()
                        end
                    end
                    Build.Phase = (_dvfvr("ORoDDBEOEA1NUhtWSQoABwcOQ0EJV0dMTAw=")):format(PHASE_NAME[o.phase or _dvfvr("GQkCDQo=")] or _dvfvr("RA=="), have, target)
                        .. (o.rowK and (_dvfvr("SRRMCgUXChdNDkg=") .. P.rows[o.rowK]) or "")
                    local pr, nextReady, nReady = Build.produceStep(o)
                    if pr ~= _dvfvr("AAwADQ==") then o.stuckAt = nil end
                    if pr == _dvfvr("AAwADQ==") then
                        if not nextReady and (nReady or 0) == 0 and invCount(seed) <= 0 and have <= 0 then
                            Build.stop(_dvfvr("Og0JDERDQwYBGAsHSQANCg0WTUQvAhwZAUg=") .. info.need .. _dvfvr("SQoABwcO"))
                            break
                        end
                        if (nReady or 0) > 0 then
                            Build.Status = nReady .. _dvfvr("SRgDAAsLQxcEFhhMCw0AHQlFFwEfHQkCDgMNHUhFBw0OGAoNSQQNDw0=")
                            o.stuckAt = o.stuckAt or os.clock()
                            if os.clock() - o.stuckAt > (42 - 12) then -- reset daftar lewati & jalur
                                o.stuckAt = nil
                                table.clear(Build.FieldSkip)
                                table.clear(BadEdge)
                                Reach = nil
                            end
                        elseif nextReady then
                            Build.Status = _dvfvr("JA0CHQoCBBFNBwcEBgZMGw0EE0Tc") .. waitText(nextReady)
                        elseif invCount(seed) <= 0 then
                            Build.Status = _dvfvr("Og0JDEQNAgYEBEhKSRwFDAUOQwUJFkgYDAUcCRBFEwUeFgYLRBgJCwUNQwAEVxsNBBgFBgNFCAUfFgMYDBo=")
                        else
                            Build.Status = _dvfvr("PQEICQ9FAgAMVxwJBBgNHEQRAgoMGkRMBA0CHQoCBBE=")
                        end
                        if not waitAuto((1280 - 280)) then break end
                    end
                end
            end
        end
    end
    releaseInput()
end

