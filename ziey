local function clearLoop()
    local idle, lastUi, lastCount = 0, 0, -(14 - 4)
    while Clear.Running and alive() do
        task.wait()
        local now = os.clock()
        if now - lastCount > (4 - 1) then
            lastCount = now
            Clear.Remaining = countRemaining()
            if not Clear.Running or not alive() then break end
        end
        if now - lastUi > 0.5 then
            lastUi = now
            updateClearStatus()
        end
        local w = Refs.World
        local s = playerState()
        if not w or not s or s.dead then
            releaseInput()
            Clear.Status = _dvfvr("JA0CHQoCBBFNHAkeCAMYDRZFTEQaGBoADUZCRg==")
            task.wait(0.5)
            continue
        end
        if not s.grounded then
            releaseInput() -- masih di udara, tunggu mendarat
            continue
        end
        releaseInput()

        local topRow = scanTopRow()
        if not topRow then
            local remaining = countRemaining()
            Clear.Remaining = remaining
            if remaining == 0 then
                stopClear(_dvfvr("PgceBABFEBEJFgBMCw0eGw0NQg=="))
                return
            end
            idle += 1
            if idle >= (5 - 2) then
                stopClear((_dvfvr("Og0ADRcECkpNJAEfCEhJDEQRCggIVxwFDQkHSAYMEAVNEwEGCAYLAwUQQ0tNEwEcDAsNAA==")):format(remaining))
                return
            end
            Clear.Status = (_dvfvr("OgEfCURAB0QZHgQJSQwFBAESAhAEW0gPBgoNSBEJAgoKV0BJDUdfQUpLTQ==")):format(remaining, idle)
            updateClearStatus()
            table.clear(Clear.Skip)
            table.clear(ClearFail)
            table.clear(BadEdge)
            Reach = nil
            if not waitAuto((2392 - 392)) then break end
            continue
        end

        Clear.TopRow = topRow
        local bottom = topRow + 1 -- 2 baris dibersihkan dulu sebelum turun
        local dir = bandDir(topRow, s)

        -- 1) Pecahkan yang terjangkau
        local list = clearInReach(s, bottom, dir)
        if #list > 0 then
            if clearBreakList(list, s) > 0 then idle = 0 end
            continue
        end

        -- 2) Ambil drop di sekitar dengan menyusurinya (sentuhan badan), lalu jalan ke bagian berikutnya
        if Clear.Collect then
            local band0 = topRow - 1
            if Move.fetchDrops(function() return Clear.Running end, (9 - 4), function(d)
                return d.y >= band0 and d.y < bottom + (3 - 1)
            end, (9 - 1)) > 0 then
                continue
            end
        end
        local R = punchReach() - 0.35
        local useBlock = scaffoldId() ~= nil
        local sx, sy = startNode(s)
        local band = bandTargets(topRow, bottom, dir, reachFilter(sy * w.w + sx, R, useBlock))
        if #band > 0 then
            -- tujuan: 5 kolom berikutnya sesuai arah sapu
            local group = {}
            for _, t in ipairs(band) do
                if (t.x - band[1].x) * dir <= (6 - 2) then group[#group + 1] = t end
            end
            travelGroup(sx, sy, group, R, useBlock, Clear.Skip, ClearFail)
        end
    end
    releaseInput()
end

