    -- 3) cadangan: cari lewat getgc (hanya kalau diminta: berat)
    if not Drops.list and deep and type(getgc) == _dvfvr("Dx0CCxAMDAo=") then
        local ok, objects = pcall(getgc, true)
        if ok and type(objects) == _dvfvr("HQkOBAE=") then
