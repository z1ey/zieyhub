        return (_dvfvr("TAwBSEEBBw==")):format(sec // (82 - 22), sec % (75 - 15))
    end

    local function setGems(n)
        local g = Refs.Gems
        if type(n) == _dvfvr("Bx0BCgEX") and g and type(rawget(g, _dvfvr("Gg0YLwEIEA=="))) == _dvfvr("Dx0CCxAMDAo=") then
