---------------------------------------------------------------------
-- PENJAGA: deteksi Mod / Dev / pemain yang masuk world
---------------------------------------------------------------------
-- Cara kerja:
--   1. Tiap 0.5 detik baca daftar pemain di world (data game "Others").
--   2. Role dicek pakai modul Roles game (Developer / Moderator, undercover juga ketahuan).
--   3. Ada yang dicari -> semua aktivitas dihentikan, bisa juga langsung keluar world.
--   4. Setelah aman -> aktivitas sebelumnya dilanjutkan.
--      Mode keluar: tunggu X detik, masuk world lagi, cek lagi.
--      Masih ada orangnya -> keluar lagi. Sudah aman -> lanjut (Auto Farm jalan balik ke posisi awal).

do (function() -- fungsi sendiri: variabel di dalam tidak ikut batas 200 local
    local function strip(s) return (tostring(s or ""):gsub(_dvfvr("CUY="), "")) end

    local function roleOf(uid)
        if not (RolesOk and type(RolesModule) == _dvfvr("HQkOBAE=")) then return nil end
        local okD, dev = pcall(RolesModule.isDeveloper, uid)
        if okD and dev then return _dvfvr("LQ0aDQgKEwEf") end
        local okM, mod = pcall(RolesModule.isModerator, uid)
        if okM and mod then return _dvfvr("JAcIDRYEFwsf") end
        return nil
    end

    local function worldName()
        local n = Refs.World and rawget(Refs.World, _dvfvr("BwkBDQ=="))
        return type(n) == _dvfvr("GhweAQoC") and n or ""
    end

    -- Pemain lain di world ini: { id, name, role }
    local function playersHere()
        local out = {}
        local o = Refs.Others
        if not o or type(rawget(o, _dvfvr("BQEfHA=="))) ~= _dvfvr("Dx0CCxAMDAo=") then return out end
        local ok, list = pcall(o.list)
        if not ok or type(list) ~= _dvfvr("HQkOBAE=") then return out end
        for _, e in ipairs(list) do
            local uid = type(e) == _dvfvr("HQkOBAE=") and tonumber(e[1] or e.userId)
            if uid and uid ~= LocalPlayer.UserId then
                out[#out + 1] = { id = uid, name = strip(e[(4 - 2)] or e.name or uid), role = roleOf(uid) }
            end
        end
        return out
    end
    Guard.playersHere = playersHere

    local function threatsOf(list)
        local out = {}
        for _, p in ipairs(list) do
            if p.role or (Guard.Who == _dvfvr("Og0BHQVFEwEAFgEC") and not Guard.Allow[p.id]) then
                out[#out + 1] = p
            end
        end
        return out
    end

    local function label(p)
        local under = false
        if p.role and type(RolesModule.isUndercover) == _dvfvr("Dx0CCxAMDAo=") then
            local ok, u = pcall(RolesModule.isUndercover, p.id)
            under = ok and u == true
        end
        return p.name .. _dvfvr("SUA=") .. (p.role or _dvfvr("OQ0BCQ0L")) .. (under and _dvfvr("RUgZBgAAEQcCAQ0e") or "") .. _dvfvr("QA==")
    end

    local function names(list, max)
        local t = {}
        for i, p in ipairs(list) do
            if i > (max or (5 - 1)) then
                t[#t + 1] = _dvfvr("Qg==") .. (#list - i + 1) .. _dvfvr("SQQNDw0=")
                break
            end
            t[#t + 1] = label(p)
        end
        return table.concat(t, _dvfvr("RUg="))
    end

    local function anyRunning()
        return State.Running or Clear.Running or Farmer.Running or Splice.Running or Spam.On
            or Pabrik.Running or Build.Running
    end

    -- Catat aktivitas yang sedang jalan (untuk dilanjutkan nanti)
    local function snapshot()
        local tx, ty = Auto.here()
        return {
            farm = State.Running and not State.Override, clear = Clear.Running, farmer = Farmer.Running,
            spam = Spam.On, splice = Splice.Running, pabrik = Pabrik.Running, build = Build.Running,
            world = worldName(), tx = tx, ty = ty,
        }
    end

    local function stopAll()
        Auto.stopWalk()
        if Pabrik.Running then Pabrik.stop() end
        if Build.Running then Build.stop() end
        if State.Running then stopFarm() end
        if Clear.Running then
            stopClear()
            Clear.Status = _dvfvr("LQEGDQAEQzQIGQINDgk=")
        end
        if Farmer.Running then
            stopFarmer()
            Farmer.Status = _dvfvr("LQEGDQAEQzQIGQINDgk=")
        end
        if Splice.Running and Splice.stop then Splice.stop() end
        if Vend.Running and Vend.stop then Vend.stop() end
        if Spam.On then
            Spam.On = false
            if UI.SpamToggle then pcall(function() UI.SpamToggle:Set(false) end) end
        end
        Auto.releaseInput()
    end

    -- Keluar world = sama seperti tombol "Exit World" game
    local function leaveWorld()
        local m = Refs.Menu
        if m and type(rawget(m, _dvfvr("BhgJBjQMAA8IBQ=="))) == _dvfvr("Dx0CCxAMDAo=") and pcall(m.openPicker) then
            return true
        end
        local w = Refs.World
        if w and type(rawget(w, _dvfvr("CgkABA=="))) == _dvfvr("Dx0CCxAMDAo=") then
            return (pcall(w.call, _dvfvr("JQ0NHgEyDBYBEw==")))
        end
        return false
    end

    -- Masuk world lewat menu game (sama seperti ketik nama world lalu Enter)
    local function enterWorld(name, live)
        if live and not live() then return false, _dvfvr("OQ0eAgUJAgoMGUgIAAoNHAUJCAUD") end
        local w = Refs.World
        if not w or name == "" then return false, _dvfvr("BwkBCUQSDBYBE0gYAAwNA0QBCg8IAwkEHAE=") end
        local oldFg = rawget(w, _dvfvr("Dw8="))
        local m = Refs.Menu
        if m and type(rawget(m, _dvfvr("DAYYDRY="))) == _dvfvr("Dx0CCxAMDAo=") then
