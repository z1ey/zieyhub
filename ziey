local function fieldStep()
    local w = Refs.World
    local stepCfg = FC
    local s = playerState()
    if not w or not s or s.dead then
        releaseInput()
        task.wait(0.5)
        return _dvfvr("HgkFHA==")
    end
    if not s.grounded then
        releaseInput()
        Move.airCheck(s)
        task.wait()
        return _dvfvr("HgkFHA==")
    end
    Move.AirAt = nil
    releaseInput()
    if FC.batch and not FC.harvest and not FC.plant then return _dvfvr("AAwADQ==") end
    if FC.yieldHarvest and FC.yieldHarvest() then return _dvfvr("AQkeHgEWFw==") end
    local targets, nextReady
    if FC.focusHarvest and FC.harvest and not FC.plant then
        local cfg = FC
        local nearby = Move.farmerAreaTargets(s, _dvfvr("AQkeHgEWFw=="), cfg)
        if #nearby < (3 - 1) then
            local sx, sy = startNode(s)
            local R, useBlock = punchReach() - 0.35, scaffoldId() ~= nil
            targets, nextReady = farmerScan(floor(s.x), floor(s.y - 0.475), (61 - 29),
                reachFilter(sy * w.w + sx, R, useBlock))
            if FC ~= cfg or not cfg.run() or not alive() or Refs.World ~= w then return _dvfvr("HgkFHA==") end
            if Move.farmerGroupRoute(s, cfg, targets, nearby, useBlock) then return _dvfvr("BAcaDQ==") end
            if FC ~= cfg or not cfg.run() or not alive() or Refs.World ~= w then return _dvfvr("HgkFHA==") end
            s = playerState() or s
        end
    end
    if farmerWorkInReach(s) > 0 then return _dvfvr("HgceAw==") end
    if FC.yieldHarvest and FC.yieldHarvest() then return _dvfvr("AQkeHgEWFw==") end
    if FC.batch and FC.plant and FC.seed and fcSeeds() <= 0 then
        local refill = Farmer.refillSeed(FC.seed)
        if refill == _dvfvr("GQEPAwEB") or refill == _dvfvr("Gw0NDB0=") then return _dvfvr("HgceAw==") end
        if refill == _dvfvr("HgkFHA0LBA==") then return _dvfvr("Gw0KAQgJ") end
        if refill == _dvfvr("CgkCCwEJDwEJ") then return _dvfvr("HgkFHA==") end
    end
    local R = FC.batch and math.max(FC.harvest and punchReach() or 0, FC.plant and buildReach() or 0) - 0.35
        or farmReach() - 0.35
    local useBlock = scaffoldId() ~= nil
    local sx, sy = startNode(s)
    local px, py = floor(s.x), floor(s.y - 0.475)
    if not targets then
        targets, nextReady = farmerScan(px, py, (12 - 4), reachFilter(sy * w.w + sx, R, useBlock))
    end
    if FC ~= stepCfg or Refs.World ~= w or not FC.run() or not alive() then return _dvfvr("HgkFHA==") end
    if #targets == 0 then return _dvfvr("AAwADQ=="), nextReady end
    if FC.sweepPlant and targets[1].kind == _dvfvr("GQQNBhA=") then
        return Move.farmerPlantTravel(s, FC, targets[1], useBlock)
    end
    if FC.batch then
        R = (targets[1].kind == _dvfvr("AQkeHgEWFw==") and punchReach() or buildReach()) - 0.35
    end
    -- Fokus panen memakai jangkauan asli ke segala arah, termasuk beda baris.
    -- Mode tanam tetap mendekati baris pohon untuk mengambil hasil panennya.
    targets.los = targets[1].kind == _dvfvr("AQkeHgEWFw==") and not FC.focusHarvest
    if targets[1].kind == _dvfvr("GQQNBhA=") then targets.cancel = FC.yieldHarvest end
    travelGroup(sx, sy, targets, R, useBlock, FC.skip, FarmerFail)
    return _dvfvr("BAcaDQ==")
end

