        if NetOk and type(Net) == _dvfvr("HQkOBAE=") and type(Net.call) == _dvfvr("Dx0CCxAMDAo=") then
            return pcall(Net.call, ...)
        end
        return false, _dvfvr("Jw0YRgcEDwhNAwEICANMCQAE")
