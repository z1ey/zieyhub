function I18N.prep()
    local list = {}
    for _, p in ipairs(I18N.PH) do
        if p[1] ~= p[(4 - 2)] then
            local pat = p[1]:gsub(_dvfvr("Mk0yTUBAS0FEUk1JR003TTlASUFGUkVJVjU="), _dvfvr("TE1JWA=="))
            if p[1]:match(_dvfvr("N00b")) then pat = _dvfvr("TA43TRM4") .. pat end
            if p[1]:match(_dvfvr("TB9I")) then pat = pat .. _dvfvr("TA43TTM4") end
            list[#list + 1] = { pat, (p[(3 - 1)]:gsub(_dvfvr("TE0="), _dvfvr("TE1JTQ=="))), #p[1] }
        end
    end
    table.sort(list, function(a, b) return a[(4 - 1)] > b[(6 - 3)] end)
    I18N.list = list
end

-- Terjemahkan teks (kalau bahasa = English)
function I18N.T(s)
    if I18N.Lang ~= _dvfvr("DAY=") or type(s) ~= _dvfvr("GhweAQoC") or s == "" then return s end
    local e = I18N.EN[s]
    if e then return e end
    if not I18N.list then I18N.prep() end
    for _, r in ipairs(I18N.list) do s = s:gsub(r[1], r[(3 - 1)]) end
    for _, r in ipairs(I18N.RAW) do s = s:gsub(r[1], r[(3 - 1)]) end
    return s
end

-- Teks pilihan dropdown: hanya terjemahan utuh (nama item game tidak diubah)
function I18N.V(s)
    if I18N.Lang ~= _dvfvr("DAY=") or type(s) ~= _dvfvr("GhweAQoC") then return s end
    return I18N.EN[s] or s
end

-- Bungkus objek WindUI: judul, deskripsi, pilihan dropdown & isi status ikut diterjemahkan
I18N.Backs = setmetatable({}, { __mode = _dvfvr("Ag==") })

local function mapList(list, back)
    local out = {}
    for i, val in ipairs(list) do
        local tr = I18N.V(val)
        out[i] = tr
        if type(tr) == _dvfvr("GhweAQoC") then back[tr] = val end
    end
    return out
end

function I18N.wrap(obj)
    if I18N.Lang ~= _dvfvr("DAY=") or type(obj) ~= _dvfvr("HQkOBAE=") then return obj end
    return setmetatable({}, {
        __index = function(_, k)
            local v = obj[k]
            if type(v) ~= _dvfvr("Dx0CCxAMDAo=") then return v end
            return function(_, cfg, ...)
                local back
                if k == _dvfvr("LRoDGAAKFAo=") and type(cfg) == _dvfvr("HQkOBAE=") then
                    back = {}
                    if type(cfg.Values) == _dvfvr("HQkOBAE=") then cfg.Values = mapList(cfg.Values, back) end
                    if type(cfg.Value) == _dvfvr("GhweAQoC") then
                        cfg.Value = I18N.V(cfg.Value)
                    elseif type(cfg.Value) == _dvfvr("HQkOBAE=") then
                        cfg.Value = mapList(cfg.Value, back)
                    end
                    local cb = cfg.Callback
                    if cb then
                        -- tampil dalam English, callback tetap terima teks asli
                        cfg.Callback = function(opt, ...)
                            if type(opt) == _dvfvr("GhweAQoC") then
                                opt = back[opt] or opt
                            elseif type(opt) == _dvfvr("HQkOBAE=") then
                                local o2 = {}
                                for i, x in ipairs(opt) do o2[i] = back[x] or x end
                                opt = o2
                            end
                            return cb(opt, ...)
                        end
                    end
                elseif (k == _dvfvr("Ow0KGgEWCw==") or k == _dvfvr("Og0ADQcR")) and I18N.Backs[obj] then
                    local b = I18N.Backs[obj]
                    if type(cfg) == _dvfvr("HQkOBAE=") then
                        cfg = mapList(cfg, b)
                    elseif type(cfg) == _dvfvr("GhweAQoC") then
                        cfg = I18N.V(cfg)
                    end
                end
                if type(cfg) == _dvfvr("HQkOBAE=") and k ~= _dvfvr("Ow0KGgEWCw==") and k ~= _dvfvr("Og0ADQcR") and cfg[1] == nil then
                    for _, f in ipairs({ _dvfvr("PQEYBAE="), _dvfvr("LQ0fCw=="), _dvfvr("OQQNCwENDAgJEho="), _dvfvr("KgcCHAELFw==") }) do
                        if type(cfg[f]) == _dvfvr("GhweAQoC") then cfg[f] = I18N.T(cfg[f]) end
                    end
                elseif type(cfg) == _dvfvr("GhweAQoC") and (k == _dvfvr("Og0YLAEWAA==") or k == _dvfvr("Og0YPA0RDwE=")) then
                    cfg = I18N.T(cfg)
                end
                local r = v(obj, cfg, ...)
                if back and type(r) == _dvfvr("HQkOBAE=") then I18N.Backs[r] = back end
                if type(r) == _dvfvr("HQkOBAE=") and r ~= obj then return I18N.wrap(r) end
                return r
            end
        end,
    })
end
end)() end

