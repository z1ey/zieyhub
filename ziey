                        if okc and msg then Bonus.LastQuestMsg = strip(msg) end
                    end
                    task.wait(0.6)
                elseif have >= need then
                    wait += 1
                end
            end
            Bonus.ResetAt = os.clock() + (tonumber(data.resetIn) or 0)
            Bonus.QuestText = (_dvfvr("Og0ADRcECkRIE0dJDUgQSAAMCAgMHgVMGgseARQRWURIEw==")):format(done, total, Bonus.Claimed)
                .. ((wait > 0) and (_dvfvr("SRRMDA0RDAgMHFJM") .. wait) or "")
        end
        Bonus.BusyQ = false
    end

    -- Tukar 1 code. Berhasil kalau balasan server diawali warna hijau (`2)
    function Bonus.redeem(code)
        local ok, res = netCall(_dvfvr("JAcIKwsIDgUDEw=="), _dvfvr("Gw0IDQEIAAsJEg=="), code)
        if not ok then return nil, _dvfvr("HQEICQ9FAQ0eFkgHDEgfDRYTBhY=") end
        local lines = type(res) == _dvfvr("HQkOBAE=") and type(res.lines) == _dvfvr("HQkOBAE=") and res.lines or nil
        if not lines then return false, _dvfvr("CwkACRcEDUQGGBsDBw8=") end
        local first = tostring(lines[1] or "")
        local parts = {}
        for _, l in ipairs(lines) do parts[#parts + 1] = strip(l) end
        return string.sub(first, 1, (4 - 2)) == _dvfvr("CVo="), table.concat(parts, _dvfvr("SQ=="))
    end

    function Bonus.checkCodes()
        if Bonus.BusyR then return end
        Bonus.BusyR = true
        local ok, list = netCall(_dvfvr("KAsYARIAIAsJEhs="))
        if not ok or type(list) ~= _dvfvr("HQkOBAE=") then
            Bonus.CodeText = _dvfvr("LgkLCQhFAgkPHgRMDQkKHAUXQwcCEw0=")
        elseif list.note ~= nil then
            Bonus.CodeText = _dvfvr("Ow0IDQEIQxcIEwkCDkgIARAQFxEdTUg=") .. strip(list.note)
        else
            local total, have, newOk = 0, 0, 0
            for _, c in ipairs(list) do
                total += 1
                local code = c.code and tostring(c.code)
                if c.done then
                    have += 1
                elseif code and not Bonus.Tried[code] and not (type(c.uses) == _dvfvr("Bx0BCgEX") and c.uses == 0) then
                    local success, msg = Bonus.redeem(code)
                    if success ~= nil then Bonus.Tried[code] = true end -- server sudah jawab
                    if success then
                        have += 1
                        newOk += 1
                        Bonus.Redeemed += 1
                        notify(_dvfvr("Ow0IDQEIQwYIBQANGgEA"), code .. _dvfvr("U0g=") .. tostring(msg), (8 - 3))
                        Hook.send(_dvfvr("CwcCHRc="), _dvfvr("Ow0IDQEIQwYIBQANGgEASA==") .. code .. _dvfvr("U0g=") .. tostring(msg))
                    elseif success == false then
                        Bonus.LastCodeMsg = code .. _dvfvr("U0g=") .. tostring(msg)
                    end
                    task.wait(1)
                end
            end
            Bonus.CodeText = (_dvfvr("KgcIDUQECBAEEVJMTAxMFEQWFgAMH0gIABwZAwUXWURIE0gQSQwFHBEOAhZNBAseABgYUkRABw==")):format(total, have, Bonus.Redeemed)
        end
        Bonus.BusyR = false
    end

    function Bonus.updateStatus()
        local now = os.clock()
        local q = Bonus.QuestText
        if Bonus.ResetAt then q = q .. _dvfvr("YzkZDRcRQwYMBR1MDQkACQlF") .. timeText(Bonus.ResetAt - now) end
        if Bonus.LastQuestMsg then q = q .. _dvfvr("YzgJGwULQxAIBQkHAQEeUkQ=") .. Bonus.LastQuestMsg end
        q = q .. _dvfvr("Yw==") .. (Bonus.Quest and (_dvfvr("Kg0HSAgEBA1NEwkACAVM") .. math.max(0, math.ceil(Bonus.NextQuest - now)) .. _dvfvr("SQwJHA0O")) or _dvfvr("KB0YB0QODwUEGkgBCBwF"))
        local c = Bonus.CodeText
        if Bonus.LastCodeMsg then c = c .. _dvfvr("YzgJGwULQxAIBQkHAQEeUkQ=") .. Bonus.LastCodeMsg end
        c = c .. _dvfvr("Yw==") .. (Bonus.Redeem and (_dvfvr("Kg0HSAgEBA1NEwkACAVM") .. timeText(Bonus.NextCode - now)) or _dvfvr("KB0YB0QXBgAIEgVMBAkYAQ=="))
        if UI.QuestStatus then pcall(function() UI.QuestStatus:SetDesc(q) end) end
        if UI.CodeStatus then pcall(function() UI.CodeStatus:SetDesc(c) end) end
    end

    task.spawn(function()
        while alive() do
            local now = os.clock()
            if Bonus.Quest and now >= Bonus.NextQuest then
                Bonus.NextQuest = now + Bonus.QuestEvery
                pcall(Bonus.checkQuests)
            end
            if Bonus.Redeem and now >= Bonus.NextCode then
                Bonus.NextCode = now + Bonus.CodeEvery
                pcall(Bonus.checkCodes)
            end
            Bonus.updateStatus()
            task.wait(1)
        end
    end)
end)() end

