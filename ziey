---------------------------------------------------------------------
-- TAS: auto recycle item sampah & auto convert lock
---------------------------------------------------------------------
-- Cara kerja (sama seperti tombol di inventori game):
--   Recycle : hapus dari inventori lalu World.call("Recycle", id, jumlah)
--   Convert : 100 World Lock -> 1 Diamond Lock, 100 Diamond Lock -> 1 Blue Gem Lock
--             lewat World.call("ConvertLock", dari, ke)
-- Tool & lock tidak bisa dipilih untuk recycle (supaya tidak terbuang tidak sengaja).
local Bag = {
    TrashOn = false,
    TrashList = {},    -- daftar id item yang di-recycle
    TrashAt = (169 - 19),     -- recycle kalau jumlahnya sudah segini
    Keep = 0,          -- sisakan sebanyak ini
    LockOn = false,
    Recycled = 0,
    Converted = 0,
    Status = _dvfvr("RA=="),
}

do (function()
    local LOCK_IDS = { [(467 - 225)] = true, [(1870 - 74)] = true, [(7547 - 359)] = true }
    local LOCK_STEPS = {
        { from = (416 - 174), to = (2114 - 318), name = _dvfvr("LQENBQsLB0QhGAsH") },
        { from = (2125 - 329), to = (7510 - 322), name = _dvfvr("KwQZDUQiBglNOwcPAg==") },
    }

    local function worldCall(...)
        local w = Refs.World
        local f = w and rawget(w, _dvfvr("CgkABA=="))
        if type(f) ~= _dvfvr("Dx0CCxAMDAo=") then return false end
        return pcall(f, ...)
    end

    local function trashable(id)
        local it = ItemDB[id]
        return it ~= nil and it.kind ~= _dvfvr("HQcDBA==") and not LOCK_IDS[id]
    end

    function Bag.recycle(id, n)
        if not Refs.Inv or n <= 0 or not trashable(id) then return false end
        n = math.min(n, invCount(id))
        if n <= 0 then return false end
        pcall(function() Refs.Inv:remove(id, n) end)
        local ok = worldCall(_dvfvr("Ow0PEQcJBg=="), id, n)
        if ok then
            Bag.Recycled += n
            Bag.Status = (_dvfvr("Ow0PEQcJBkRIBEgUTAw=")):format(itemName(id), n)
        end
        return ok
    end

    -- sama seperti cek tombol convert di game (muat atau tidak)
    local function convertLock(step)
        local inv = Refs.Inv
        if not inv or invCount(step.from) < (101 - 1) then return false end
        local okU, used = pcall(function() return inv:used() end)
        local okC, cap = pcall(function() return inv.capacity end)
        if invCount(step.to) + 1 > (276 - 76) then return false end
        if invCount(step.to) == 0 and invCount(step.from) ~= (195 - 95) and okU and okC
            and type(used) == _dvfvr("Bx0BCgEX") and type(cap) == _dvfvr("Bx0BCgEX") and used >= cap then
            return false
        end
        pcall(function()
            inv:remove(step.from, (193 - 93))
            inv:add(step.to, 1)
        end)
        local ok = worldCall(_dvfvr("KgcCHgEXFygCFAM="), step.from, step.to)
        if ok then
            Bag.Converted += 1
            Bag.Status = _dvfvr("KgcCHgEXF0QGEkg=") .. step.name
        end
        return ok
    end

    function Bag.tick()
        if Bag.TrashOn then
            for _, id in ipairs(Bag.TrashList) do
                local n = invCount(id)
                if n >= Bag.TrashAt and n > Bag.Keep then
                    Bag.recycle(id, n - Bag.Keep)
                    task.wait(0.5)
                end
            end
        end
        if Bag.LockOn then
            for _, step in ipairs(LOCK_STEPS) do
                if convertLock(step) then task.wait(0.5) end
            end
        end
    end

    -- label dropdown: item di inventori yang boleh di-recycle
    function Bag.labels()
        local out, seen = {}, {}
        for _, slot in ipairs(Refs.inventoryEntries()) do
            local id = slot.id
            if not seen[id] and trashable(id) then
                seen[id] = true
                out[#out + 1] = { id = id, label = (_dvfvr("TBtMM0EBPg==")):format(itemName(id), id) }
            end
        end
        -- item yang sudah dipilih tetap tampil walau sedang habis
        for _, id in ipairs(Bag.TrashList) do
            if not seen[id] then
                seen[id] = true
                out[#out + 1] = { id = id, label = (_dvfvr("TBtMM0EBPg==")):format(itemName(id), id) }
            end
        end
        table.sort(out, function(a, b) return a.id < b.id end)
        local labels, picked = {}, {}
        for _, e in ipairs(out) do
            labels[#labels + 1] = e.label
            if table.find(Bag.TrashList, e.id) then picked[#picked + 1] = e.label end
        end
        return labels, picked
    end

    task.spawn(function()
        while alive() do
            pcall(Bag.tick)
            if UI.BagStatus then
                local txt = (_dvfvr("OhwNHBEWWURIBGIoAEUeDQccAAgITUhJDUgFHAEIQxhNNAcCHw0eHEQJDAcGTUhJDUgHCQgMaS0ZEgVMDQEcAQgMC15NUgw=")):format(
                    Bag.Status, Bag.Recycled, Bag.Converted, #Bag.TrashList)
                if txt ~= Bag.Shown then
                    Bag.Shown = txt
                    pcall(function() UI.BagStatus:SetDesc(txt) end)
                end
            end
            task.wait((4 - 1))
        end
    end)
end)() end

