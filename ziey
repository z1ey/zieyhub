    local name = string.lower(tostring(it.name or "")):gsub(_dvfvr("VUZBVg=="), ""):gsub(_dvfvr("CUY="), ""):gsub(_dvfvr("MjdJRUEWPk8="), _dvfvr("SQ=="))
    if name:find(_dvfvr("TA43TQU4DwsOHE0KMk0tNQ==")) then return true end
    local compact = name:gsub(_dvfvr("TBs="), "")
    return compact == _dvfvr("HgceBAAJDAcG") or compact == _dvfvr("DQENBQsLBwgCFAM=") or compact == _dvfvr("CwQZDQMADggCFAM=")
        or compact == _dvfvr("Dh0FBAAJDAcG") or compact == _dvfvr("GgUNBAgJDAcG") or compact == _dvfvr("CwELBAsGCA==")
        or compact == _dvfvr("AR0LDQgKAA8=") or compact == _dvfvr("Cx0FBAAAERcBGAsH")
