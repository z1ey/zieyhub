-- AUTO RECONNECT
---------------------------------------------------------------------
-- Cara kerja:
--   Terlempar dari world (event WorldClosed dari server):
--     catat aktivitas -> tunggu -> masuk world yang sama lagi -> lanjut aktivitas.
--   Disconnect dari server Roblox (layar error muncul):
--     catat aktivitas ke file -> teleport ulang ke game dengan data world
--     (game otomatis masuk world itu) -> script jalan lagi -> lanjut aktivitas.
--     Supaya script jalan lagi setelah teleport: isi URL script (queue_on_teleport)
--     atau taruh script di folder autoexec executor.
local Rejoin = {
    On = false,
    World = true,       -- masuk lagi kalau terlempar dari world
    Server = true,      -- rejoin kalau disconnect dari server
    DelaySec = (10 - 5),
    ScriptUrl = "",
    Keep = false,       -- selalu kembali ke world tujuan kalau berada di luar world
    Target = "",        -- world tujuan (kosong = world terakhir)
    LastWorld = "",     -- world terakhir yang dimasuki
    Last = nil,         -- catatan aktivitas terakhir
    LastAt = 0,
    Busy = false,
    Count = 0,
    Status = _dvfvr("RA=="),
}

do (function()
    local HttpService = game:GetService(_dvfvr("IRwYGDcAERIEFA0="))
    local TeleportService = game:GetService(_dvfvr("PQ0ADRQKERA+EhoaAAsJ"))
    local GuiService = game:GetService(_dvfvr("Lh0FOwEXFQ0OEg=="))
    local canFile = type(writefile) == _dvfvr("Dx0CCxAMDAo=") and type(readfile) == _dvfvr("Dx0CCxAMDAo=") and type(isfile) == _dvfvr("Dx0CCxAMDAo=")
    local PENDING = _dvfvr("MwEJESwwIUsfEgIDAAYz") .. tostring(LocalPlayer.UserId) .. _dvfvr("RwIfBwo=")

    -- catat aktivitas selagi masih jalan
    task.spawn(function()
        while alive() do
            local now = os.clock()
            local wn = Guard.worldName and Guard.worldName() or ""
            if wn ~= "" and not Pabrik.Traveling then Rejoin.LastWorld = wn end
            if Guard.anyRunning and Guard.anyRunning() and Guard.Mode == _dvfvr("AAwADQ==") then
                Rejoin.Last = Guard.snapshot()
                Rejoin.LastAt = now
            elseif now - Rejoin.LastAt > (6 - 3) and Guard.Mode == _dvfvr("AAwADQ==") and wn ~= "" then
                -- masih di world tapi aktivitas dihentikan sendiri: jangan dilanjutkan
                Rejoin.Last = nil
            end
            task.wait(1)
        end
    end)

    local function resume(saved, reason)
        Guard.afterEnter()
        Rejoin.Count += 1
        Rejoin.Status = _dvfvr("JAkfHQ9FDwUKHkgODBoECRcMD0hNGwkCAx0YSAUOFw0bHhwNGg==")
        notify(_dvfvr("KB0YB0Q3BgcCGQYJChw="), reason .. _dvfvr("U0gACQoPFhBNFgMYAB4FHAUW"), (6 - 2))
        Hook.send(_dvfvr("Gw0GBw0L"), reason .. _dvfvr("SQMJSA==") .. tostring(saved.world) .. _dvfvr("RUgNAxAMFQ0ZFhtMDQEACQoPFhAGFgY="))
        Guard.resumeSaved(saved)
    end

    -- ===== terlempar dari world =====
    local function onWorldClosed(msg)
        if not (Rejoin.On and Rejoin.World) or Rejoin.Busy or Pabrik.Traveling then return end
        if Guard.Mode == _dvfvr("CB8NEQ==") or Guard.Mode == _dvfvr("Bh0Y") then return end -- Penjaga yang keluar
        local saved = Rejoin.Last
        if not saved or saved.world == "" or os.clock() - Rejoin.LastAt > (13 - 3) then return end
        Rejoin.Busy = true
        task.spawn(function()
            Guard.stopAll()
            local text = tostring(msg or ""):gsub(_dvfvr("CUY="), "")
            Rejoin.Status = _dvfvr("PQ0eBAEIEwUfVwwNGwFM") .. saved.world .. _dvfvr("R0ghCRcQCEQBFg8FR0ZC")
            Hook.send(_dvfvr("Gw0GBw0L"), _dvfvr("PQ0eBAEIEwUfVwwNGwFMHwsXDwBN") .. saved.world .. (text ~= "" and (_dvfvr("SUA=") .. text .. _dvfvr("QA==")) or ""))
            task.wait(Rejoin.DelaySec + 1.5) -- tunggu animasi pintu selesai
            for try = 1, (5 - 2) do
                if not (alive() and Rejoin.On) then break end
                local ok, err = Guard.enterWorld(saved.world)
                if ok then
                    task.wait(1.5)
                    resume(saved, _dvfvr("JAkfHQ9FDwUKHg=="))
                    Rejoin.Busy = false
                    return
                end
                Rejoin.Status = (_dvfvr("LgkLCQhFDgUeAgNMQU0IR1dMWURIBA==")):format(try, tostring(err))
                task.wait((15 - 5))
            end
            Rejoin.Status = _dvfvr("LgkLCQhFDgUeAgNMBQkLAUQOBkQ=") .. saved.world
            notify(_dvfvr("KB0YB0Q3BgcCGQYJChw="), Rejoin.Status, (6 - 1))
            Hook.send(_dvfvr("Gw0GBw0L"), Rejoin.Status)
            Rejoin.Busy = false
        end)
    end

    -- game v1159+: WorldClosed lewat paket Net (ByteNet), bukan RemoteEvent bernama lagi.
    -- Net.on hanya MENDENGAR (tidak kirim apa pun ke server). Listener tidak bisa dilepas,
    -- jadi dicek alive() supaya script lama yang sudah ditutup tidak ikut jalan.
    local closedHooked = false
    if NetOk and type(Net) == _dvfvr("HQkOBAE=") and type(Net.on) == _dvfvr("Dx0CCxAMDAo=")
        and type(Net.EVENTS) == _dvfvr("HQkOBAE=") and Net.EVENTS.WorldClosed then
        closedHooked = pcall(Net.on, _dvfvr("PgceBAAmDwseEgw="), function(msg)
            if alive() then onWorldClosed(msg) end
        end, function()
            local w = Refs.World
            return w and rawget(w, _dvfvr("BwkBDQ==")) or ""
        end)
    end
    if not closedHooked then
        local closed = WorldRemotes:FindFirstChild(_dvfvr("PgceBAAmDwseEgw="))
        if closed and closed:IsA(_dvfvr("Ow0BBxAAJhIIGRw=")) then
            table.insert(Connections, closed.OnClientEvent:Connect(function(msg)
                if alive() then onWorldClosed(msg) end
            end))
        end
    end

    -- ===== rejoin manual & selalu kembali ke world =====
    -- Cara kerja:
    --   Rejoin manual : catat aktivitas -> keluar world -> masuk lagi -> lanjut aktivitas.
    --   Selalu kembali: tiap 2 detik cek, kalau kamu di luar world (layar pilih world)
    --                   lebih lama dari jeda -> masuk ke world tujuan -> lanjut aktivitas.
    function Rejoin.targetWorld()
        local t = tostring(Rejoin.Target or ""):upper():gsub(_dvfvr("MjYtRT5VTl0w"), "")
        if t ~= "" then return t end
        return Rejoin.LastWorld or ""
    end

    local function enterAndResume(world, saved, reason)
        for try = 1, (6 - 3) do
            if not alive() then return false end
            local ok, err = Guard.enterWorld(world)
            if ok then
                task.wait(1.5)
                if saved and saved.world == world then
                    resume(saved, reason)
                else
                    Guard.afterEnter()
                    Rejoin.Count += 1
                    Rejoin.Status = reason .. _dvfvr("SQMJSA==") .. world .. _dvfvr("SQoJGgwEEA0B")
                    Hook.send(_dvfvr("Gw0GBw0L"), reason .. _dvfvr("SQMJSA==") .. world)
                end
                return true
            end
            Rejoin.Status = (_dvfvr("LgkLCQhFDgUeAgNMTBtMQEEBTFdETUhJGg==")):format(world, try, tostring(err))
            task.wait((15 - 7))
        end
        notify(_dvfvr("KB0YB0Q3Bg4CHgY="), _dvfvr("LgkLCQhFDgUeAgNM") .. world, (6 - 1))
        Hook.send(_dvfvr("Gw0GBw0L"), _dvfvr("LgkLCQhFDgUeAgNM") .. world)
        return false
    end

    function Rejoin.now()
        if Rejoin.Busy then
            notify(_dvfvr("KB0YB0Q3Bg4CHgY="), _dvfvr("Og0ICQoCQxQfGBsJGkgBCRcQCEQaGBoADURMHBELBAMYVwwZBR0="), (6 - 3))
            return
        end
        local world = Rejoin.targetWorld()
        if world == "" then
            notify(_dvfvr("KB0YB0Q3Bg4CHgY="), _dvfvr("PgceBABFFxEHAgkCSQoJBBEIQwUJFkZMIBsFSEMyDBYBE0gYHAIZCQpCQwUZFh1MBAkfHQ9FFAsfGwxMDR0AHQ=="), (8 - 4))
            return
        end
        Rejoin.Busy = true
        task.spawn(function()
            local saved = nil
            if Guard.worldName() ~= "" then
                if Guard.anyRunning() then saved = Guard.snapshot() end
                Guard.stopAll()
                Rejoin.Status = _dvfvr("Ig0AHQUXQxMCBQQIR0ZC")
                if not Guard.leaveWorld() then
                    Rejoin.Status = _dvfvr("LgkLCQhFCAEBAgkeSR8DGggB")
                    notify(_dvfvr("KB0YB0Q3Bg4CHgY="), Rejoin.Status, (7 - 3))
                    Rejoin.Busy = false
                    return
                end
                task.wait(math.max((3 - 1), Rejoin.DelaySec))
            end
            if saved and saved.world ~= world then saved = nil end -- world lain: aktivitas tidak dilanjutkan
            Rejoin.Status = _dvfvr("JAkfHQ9FCAFN") .. world .. _dvfvr("R0ZC")
            enterAndResume(world, saved, _dvfvr("Ow0GBw0L"))
            Rejoin.Busy = false
        end)
    end

    task.spawn(function()
        local outSince = nil
        while alive() do
            task.wait((4 - 2))
            local out = Guard.worldName() == ""
            local free = Rejoin.On and Rejoin.Keep and not Rejoin.Busy and not Rejoin.Leaving and not Pabrik.Traveling
                and Guard.Mode == _dvfvr("AAwADQ==")
            if not (out and free) then
                outSince = nil
            else
                outSince = outSince or os.clock()
                local world = Rejoin.targetWorld()
                if world ~= "" and os.clock() - outSince >= Rejoin.DelaySec then
                    outSince = nil
                    Rejoin.Busy = true
                    local saved = Rejoin.Last
                    if saved and (saved.world ~= world or os.clock() - Rejoin.LastAt > (976 - 376)) then saved = nil end
                    Rejoin.Status = _dvfvr("LQFMBBEEEUQaGBoADURMBQUWFg9NHA1M") .. world .. _dvfvr("R0ZC")
                    enterAndResume(world, saved, _dvfvr("Ig0BCgUJCkQCAwcBCBwFGw=="))
                    Rejoin.Busy = false
                end
            end
        end
    end)

    -- ===== disconnect dari server =====
    local function queueScript()
        local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        local url = tostring(Rejoin.ScriptUrl or "")
        if type(q) == _dvfvr("Dx0CCxAMDAo=") and string.sub(url, 1, (9 - 1)) == _dvfvr("ARwYGBdfTEs=") then
            pcall(q, (_dvfvr("BQcNDBcREQ0DEEALCAUJUiwRFxQqEhxETBlFQUxM")):format(url))
            return true
        end
        return false
    end

    local function onDisconnect(msg)
        if not (Rejoin.On and Rejoin.Server) or Rejoin.Leaving then return end
        Rejoin.Leaving = true
        local saved = Rejoin.Last or (Guard.anyRunning() and Guard.snapshot()) or nil
        local world = saved and saved.world or Guard.worldName()
        if canFile and saved then
            local data = {
                world = saved.world, farm = saved.farm, clear = saved.clear, farmer = saved.farmer,
                spam = saved.spam, splice = saved.splice, pabrik = saved.pabrik, build = saved.build,
                tx = saved.tx, ty = saved.ty, at = os.time(),
            }
            pcall(function() writefile(PENDING, HttpService:JSONEncode(data)) end)
        end
        local queued = queueScript()
        Rejoin.Status = _dvfvr("LQEfCwsLDQEOA1JMGw0GBw0LTUpD") .. (queued and "" or _dvfvr("SUAfCxYMExBNAwEICANMDA1IEhEIAg1F"))
        Hook.send(_dvfvr("Gw0GBw0L"), _dvfvr("LQEfCwsLDQEOA0gICBoFSBcAERIIBUhE") .. tostring(msg) .. _dvfvr("QEZMOgEPDA0DVwMJSQ==") .. (world ~= "" and world or _dvfvr("DgkBDQ==")))
        task.spawn(function()
            task.wait(Rejoin.DelaySec)
            while alive() do
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer, (world ~= "") and { world = world } or nil)
                end)
                task.wait((28 - 13)) -- belum pindah: coba lagi
            end
        end)
    end

    pcall(function()
        table.insert(Connections, GuiService.ErrorMessageChanged:Connect(function(msg)
            if alive() and type(msg) == _dvfvr("GhweAQoC") and msg ~= "" then onDisconnect(msg) end
        end))
    end)

    -- ===== setelah execute: lanjutkan dari catatan rejoin =====
    function Rejoin.startup(reconnectFn)
        if not canFile then return end
        local okE, has = pcall(isfile, PENDING)
        if not okE or not has then return end
        local okR, raw = pcall(readfile, PENDING)
        if type(delfile) == _dvfvr("Dx0CCxAMDAo=") then pcall(delfile, PENDING) end
        if not okR or type(raw) ~= _dvfvr("GhweAQoC") then return end
        local okD, saved = pcall(HttpService.JSONDecode, HttpService, raw)
        if not okD or type(saved) ~= _dvfvr("HQkOBAE=") or type(saved.world) ~= _dvfvr("GhweAQoC") or saved.world == "" then return end
        if os.time() - (tonumber(saved.at) or 0) > (23 - 8) * (119 - 59) then return end -- terlalu lama
        Rejoin.Busy = true
        Rejoin.Status = _dvfvr("Ow0GBw0LWUQAEgYZBw8LHUQIAhcYHEg=") .. saved.world
        -- tunggu game masuk world (lewat data teleport); kalau tidak, masuk sendiri
        local t0 = os.clock()
        local tried = false
        while alive() and os.clock() - t0 < (94 - 34) do
            if Refs.World and Guard.worldName() == saved.world and Auto.here() then break end
            if not Refs.World then pcall(reconnectFn) end
            if Refs.World and not tried and os.clock() - t0 > (19 - 7) then
                tried = true
                Guard.enterWorld(saved.world)
            end
            task.wait((3 - 1))
        end
        if alive() and Guard.worldName() == saved.world then
            pcall(reconnectFn)
            task.wait(1)
            resume(saved, _dvfvr("Ow0GBw0LQxcIBR4JGw=="))
        else
            Rejoin.Status = _dvfvr("Ow0GBw0LWUQKFg8NBUgBCRcQCEQ=") .. saved.world
            Hook.send(_dvfvr("Gw0GBw0L"), Rejoin.Status)
        end
        Rejoin.Busy = false
