do (function()
    local function gemsNow()
        local g = Refs.Gems
        local f = g and rawget(g, _dvfvr("CAwILwEIEA=="))
        if type(f) ~= _dvfvr("Dx0CCxAMDAo=") then return nil end
        for _, v in pairs(getUpvalues(f)) do
            if type(v) == _dvfvr("Bx0BCgEX") then return v end
        end
        return nil
    end
    Stats.gemsNow = gemsNow

    local function fmt(n)
        local str = tostring(math.floor(n or 0))
        local neg = string.sub(str, 1, 1) == _dvfvr("RA==")
        if neg then str = string.sub(str, (3 - 1)) end
        local out = str:reverse():gsub(_dvfvr("QU0ITQBAB00="), _dvfvr("TFlC")):reverse()
        out = out:gsub(_dvfvr("N01C"), "")
        return (neg and _dvfvr("RA==") or "") .. out
    end

    local function dur(sec)
        sec = math.max(0, math.floor(sec))
        return (_dvfvr("TAwGSEEBDkRIEww=")):format(sec // (3685 - 85), sec % (3673 - 73) // (76 - 16), sec % (88 - 28))
    end

    -- angka yang dihitung (semuanya naik terus selama script jalan)
    local function counters()
        return {
            broken = State.Broken, placed = State.Placed, collected = State.Collected,
            harvested = Farmer.Harvested, planted = Farmer.Planted,
        }
    end

    function Stats.reset()
        Stats.T0 = os.clock()
        Stats.Gems0 = gemsNow()
        Stats.Items = {}
        Stats.Base = counters()
    end
    Stats.Base = counters()

    function Stats.text()
        local hours = math.max((os.clock() - Stats.T0) / (4048 - 448), 1 / (3741 - 141))
        local now, base = counters(), Stats.Base
        local function line(label, key)
            local v = now[key] - (base[key] or 0)
            return (_dvfvr("TBtWSEEWQ0RFUhtDAwkBQQ==")):format(label, fmt(v), fmt(v / hours))
        end
        local g = gemsNow()
        if g and not Stats.Gems0 then Stats.Gems0 = g end
        local gemLine = _dvfvr("Lg0BG15FTg==")
        if g and Stats.Gems0 then
            local d = g - Stats.Gems0
            gemLine = (_dvfvr("Lg0BG15FRhdNV0BJGk0fRERAEEsHFgVF")):format(fmt(g), d >= 0 and _dvfvr("Qg==") or "", fmt(d), fmt(d / hours))
        end
