---------------------------------------------------------------------
-- GROWSCAN: Floating Items & World Blocks (seperti Growscan 9000 di Growtopia)
---------------------------------------------------------------------
-- Cara kerja:
--   - Floating Items: daftar drop di world (data drop game), dijumlah per item.
--   - World Blocks: semua tile world dihitung per item (block depan + background).
--     Seed yang tertanam di block depan = pohon.
--   - Auto Scan: diulang tiap 2 detik. Hasil diurutkan dari jumlah terbanyak.
local Scan = {
    Auto = false,
    Layer = _dvfvr("Og0BHQU="),      -- "Semua" | "Depan" | "Background"
    Filter = "",          -- cari nama item
    Every = (3 - 1),
    Limit = (93 - 33),           -- maksimal baris per daftar
    Last = nil,
}

do (function() -- fungsi sendiri: variabel di dalam tidak ikut batas 200 local
    local function fmtNum(n)
        local str = tostring(math.floor(n))
        local out = str:reverse():gsub(_dvfvr("QU0ITQBAB00="), _dvfvr("TFlC")):reverse()
        return (out:gsub(_dvfvr("N01C"), ""))
    end

    local function blockName(id)
        local it = ItemDB[id]
        local nm = itemName(id)
        if it and it.kind == _dvfvr("Gg0JDA==") then nm = nm .. _dvfvr("SUAcBwwKDU0=") end
        return nm
    end

    -- Ubah hitungan {id = jumlah} jadi teks, urut dari terbanyak
    local function listText(counts, nameFn)
        local list = {}
        for id, n in pairs(counts) do list[#list + 1] = { id = id, n = n } end
        table.sort(list, function(a, b)
            if a.n ~= b.n then return a.n > b.n end
            return a.id < b.id
        end)
        local filter = string.lower(Scan.Filter or "")
        local lines, total = {}, 0
        for _, e in ipairs(list) do
            local name = nameFn(e.id)
            if filter == "" or string.find(string.lower(name), filter, 1, true) then
                total += 1
                if total <= Scan.Limit then
                    lines[#lines + 1] = name .. _dvfvr("SUgU") .. fmtNum(e.n)
                end
            end
        end
        if total > Scan.Limit then lines[#lines + 1] = (_dvfvr("R0ZCSE9AB0QEAw0BSQQNAQpFSxQMHAkFSSsNGg1FChAIGkE=")):format(total - Scan.Limit) end
        if #lines == 0 then lines[1] = (filter ~= "") and _dvfvr("PQEICQ9FAgAMVxENBw9MCwsGDA8=") or _dvfvr("IgcfBwoC") end
        return table.concat(lines, _dvfvr("Yw==")), total
    end

    local function scanFloating()
        local counts, total, piles = {}, 0, 0
        local list = Drops.list
        if type(list) ~= _dvfvr("HQkOBAE=") then return nil end
        for _, d in pairs(list) do
            if type(d) == _dvfvr("HQkOBAE=") and type(d.id) == _dvfvr("Bx0BCgEX") then
                local n = tonumber(d.n) or 1
                if n > 0 then
                    counts[d.id] = (counts[d.id] or 0) + n
                    total += n
                    piles += 1
                end
            end
        end
        return counts, total, piles
    end

    local function scanBlocks()
        local w = Refs.World
        if not w or type(w.fg) ~= _dvfvr("HQkOBAE=") or type(w.w) ~= _dvfvr("Bx0BCgEX") then return nil end
        local fgC, bgC, nf, nb = {}, {}, 0, 0
        local trees = {} -- [seed] = { r = siap, g = tumbuh, nxt = detik ke panen berikutnya }
        local st = workspace:GetServerTimeNow()
        local readyAt = Auto.treeReadyAt
        for y = 0, w.h - 1 do
            local rf = w.fg[y]
            local rb = w.bg and w.bg[y]
            for x = 0, w.w - 1 do
                local a = rf and rf[x] or 0
                if a ~= 0 then
                    fgC[a] = (fgC[a] or 0) + 1
                    nf += 1
                    local it = ItemDB[a]
                    if readyAt and it and it.kind == _dvfvr("Gg0JDA==") then
                        local ra = readyAt(x, y, a)
                        if ra then
                            local e = trees[a]
                            if not e then
                                e = { r = 0, g = 0 }
                                trees[a] = e
                            end
                            if st >= ra then
                                e.r += 1
                            else
                                e.g += 1
                                if not e.nxt or ra - st < e.nxt then e.nxt = ra - st end
                            end
                        end
                    end
                end
                local b = rb and rb[x] or 0
                if b ~= 0 then
                    bgC[b] = (bgC[b] or 0) + 1
                    nb += 1
                end
            end
            if y % (94 - 30) == (107 - 44) then task.wait() end -- world besar: jangan bikin lag
        end
        return fgC, bgC, nf, nb, trees
    end

    local function waitText(sec)
        sec = math.max(0, math.floor(sec or 0))
        if sec >= (3898 - 298) then return (_dvfvr("TAwGSEEBDg==")):format(sec // (3847 - 247), sec % (3975 - 375) // (102 - 42)) end
        return (_dvfvr("TAwBSEEBBw==")):format(sec // (111 - 51), sec % (112 - 52))
    end

    -- Daftar pohon: siap panen dulu, lalu yang paling cepat siap
    local function treeText(trees)
        local list, totalR, totalG = {}, 0, 0
        local filter = string.lower(Scan.Filter or "")
        for id, e in pairs(trees) do
            totalR += e.r
            totalG += e.g
            local name = itemName(id)
            if filter == "" or string.find(string.lower(name), filter, 1, true) then
                list[#list + 1] = { name = name, e = e }
            end
        end
        table.sort(list, function(a, b)
            if a.e.r ~= b.e.r then return a.e.r > b.e.r end
            return (a.e.nxt or math.huge) < (b.e.nxt or math.huge)
        end)
        local lines = {}
        for i, v in ipairs(list) do
            if i > Scan.Limit then
                lines[#lines + 1] = (_dvfvr("R0ZCSE9AB0QHEgYFGkgACQ0L")):format(#list - Scan.Limit)
                break
            end
            local line = (_dvfvr("TBtWSEEBQxcEFhhMFUhJDEQRFgkPAgA=")):format(v.name, v.e.r, v.e.g)
            if v.e.nxt then line = line .. _dvfvr("SUAODRYMCBEZVw==") .. waitText(v.e.nxt) .. _dvfvr("QA==") end
            lines[#lines + 1] = line
        end
        if #lines == 0 then lines[1] = (filter ~= "") and _dvfvr("PQEICQ9FAgAMVxENBw9MCwsGDA8=") or _dvfvr("PQEICQ9FAgAMVxgDAQcC") end
        return table.concat(lines, _dvfvr("Yw==")), totalR, totalG
    end

    local function setDesc(el, txt, key)
        if Scan[key] == txt then return end
        Scan[key] = txt
        if el then pcall(function() el:SetDesc(txt) end) end
    end

    function Scan.run()
        if Scan.Busy then return end
        Scan.Busy = true
        local w = Refs.World
        local fl, flTotal, piles = scanFloating()
        local fgC, bgC, nf, nb, trees = scanBlocks()
        local treeTxt, treeR, treeG = _dvfvr("LQkYCUQVDAwCGUgODAQZBUQOBhAIGh0="), nil, nil
        if trees then treeTxt, treeR, treeG = treeText(trees) end

        local floatText = fl and select(1, listText(fl, itemName)) or _dvfvr("LQkYCUQBEQsdVwoJBR0BSA8AFwEAAkZMPQ0HCQpFRCwYFR0CDgMNBkQOBkQKFgUJTg==")
        local blockText = _dvfvr("LQkYCUQSDBYBE0gODAQZBUQOBhAIGh1CSTwJAwULQ0MlAgoZBw8HCQpFCAFNEAkBDE8=")
        if fgC then
            local pick
            if Scan.Layer == _dvfvr("LQ0cCQo=") then
                pick = fgC
            elseif Scan.Layer == _dvfvr("KwkPAwMXDBEDEw==") then
                pick = bgC
            else
                pick = {}
                for id, n in pairs(fgC) do pick[id] = (pick[id] or 0) + n end
                for id, n in pairs(bgC) do pick[id] = (pick[id] or 0) + n end
            end
            blockText = select(1, listText(pick, blockName))
        end

        local name = w and rawget(w, _dvfvr("BwkBDQ=="))
        local info = table.concat({
            _dvfvr("PgceBABfQw==") .. ((type(name) == _dvfvr("GhweAQoC") and name ~= "") and name or _dvfvr("RA=="))
                .. (w and type(w.w) == _dvfvr("Bx0BCgEX") and (_dvfvr("SUA=") .. w.w .. _dvfvr("EQ==") .. w.h .. _dvfvr("QA==")) or ""),
            _dvfvr("KwQDCw9FBwEdFgZWSQ==") .. (nf and fmtNum(nf) or _dvfvr("RA==")) .. _dvfvr("SRRMKgUGCAMfGB0CDVJM") .. (nb and fmtNum(nb) or _dvfvr("RA==")),
            _dvfvr("LwQDCRAMDQNXVw==") .. (flTotal and (fmtNum(flTotal) .. _dvfvr("SQEYDQlFSw==") .. piles .. _dvfvr("SRwZBRQQCAUDXg==")) or _dvfvr("RA==")),
            _dvfvr("OQcEBwpfQw==") .. (treeR and (fmtNum(treeR) .. _dvfvr("SRsFCRRFEwUDEgZMFUg=") .. fmtNum(treeG) .. _dvfvr("SRwZBQYQCw==")) or _dvfvr("RA==")),
            _dvfvr("OgsNBkQRBhYMHAAFG1JM") .. os.date(_dvfvr("TCBWTSlfRjc=")),
        }, _dvfvr("Yw=="))

        setDesc(UI.ScanInfo, info, _dvfvr("NgECDgs="))
        setDesc(UI.ScanFloat, floatText, _dvfvr("Ng4ABwUR"))
        setDesc(UI.ScanBlocks, blockText, _dvfvr("NgoABwcOEA=="))
        setDesc(UI.ScanTrees, treeTxt, _dvfvr("NhweDQEW"))
        Scan.Busy = false
    end

    task.spawn(function()
        local last = 0
        while alive() do
            if Scan.Auto and os.clock() - last >= Scan.Every then
                last = os.clock()
                pcall(Scan.run)
            end
            task.wait(0.5)
        end
    end)
end)() end

