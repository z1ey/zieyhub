function _IlIllllIll.prep()
    local _llIlIllIII = {}
    for _llIlIIIIlI, _lllIIIlIIl in ipairs(_IlIllllIll.PH) do
        if _lllIIIlIIl[1] ~= _lllIIIlIIl[2] then
