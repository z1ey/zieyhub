            Desc = (o.Desc and (o.Desc .. _dvfvr("SQ==")) or "") .. _dvfvr("QQ==") .. o.Min .. _dvfvr("RA==") .. o.Max .. _dvfvr("QA=="),
            Value = tostring(o.Default),
