-- AUTO SPLICE
---------------------------------------------------------------------
-- Cara kerja (sama seperti splice manual di game):
--   1. Tanam Seed A di tile Grid yang kosong (di bawahnya harus ada block).
--   2. Taruh Seed B di atas pohon A -> World.spliceSeed(x, y, B).
--   3. Server membalas id pohon hasil splice, tile langsung diganti di layar.
--   Hasil splice diperkirakan dulu pakai modul Splice game; kalau tidak bisa, tidak dijalankan.
do (function()
    local okMod, SpliceMod = Shared:Load(_dvfvr("OhgAAQcA"))

    function Splice.result(a, b)
        if not (okMod and type(SpliceMod) == _dvfvr("HQkOBAE=") and type(SpliceMod.result) == _dvfvr("Dx0CCxAMDAo=")) then return nil end
        if not (a and b) then return nil end
        local ok, r = pcall(SpliceMod.result, a, b)
        return ok and r or nil
    end

    local function setVisual()
        if UI.SpliceToggle then pcall(function() UI.SpliceToggle:Set(Splice.Running) end) end
    end

    function Splice.stop(reason)
        Splice.Running = false
        if Splice.Roaming then Auto.stopSpliceRoam() end
        Splice.Status = reason or _dvfvr("LQEEDQoRCg8MGQ==")
        setVisual()
        if reason then notify(_dvfvr("KB0YB0Q2EwgEFA0="), reason, (8 - 4)) end
    end

    local function treeSpliced(x, y)
        local t = Auto.treeEntry(x, y)
        return type(t) == _dvfvr("HQkOBAE=") and t.s == true
    end

    local function spliceAt(x, y)
        local w = Refs.World
        local f = w and rawget(w, _dvfvr("GhgAAQcAMAEIEw=="))
        if type(f) ~= _dvfvr("Dx0CCxAMDAo=") then return false, _dvfvr("Dx0CDxcMQxcdGwEPDEgLCQkAQxAEEwkHSQMJHAEIFg==") end
        local ok, made = pcall(f, x, y, Splice.B)
        if ok and made and ItemDB[made] then
            pcall(function() Refs.Inv:remove(Splice.B, 1) end)
            if Refs.SetTile then pcall(Refs.SetTile, _dvfvr("Dw8="), x, y, made, true) end -- ganti di layar saja
            Splice.Made += 1
            Splice.Status = (_dvfvr("OhgAAQcAQw4MEwFMTBtMQEEBT0EJXg==")):format(itemName(made), x, y)
            return true
        end
        return false, _dvfvr("DQEYBwgECEQeEhoaDBo=")
    end

    local function loop(runId)
        while Splice.Running and alive() and Splice.RunId == runId do
            local px, py = getPlayerTile()
            if not px then
                Splice.stop(_dvfvr("IgkeCQ8RBhZNAwEICANMDA0RBgkYHAkCSUAHDQgQAhZNAAceBQxTQQ=="))
                return
            end
            local A, B = Splice.A, Splice.B
            local acted = false
            local now = os.clock()
            for _, o in ipairs(sortedOffsets()) do
                if not Splice.Running then break end
                local x, y = px + o.dx, py + o.dy
                local key = x .. _dvfvr("RQ==") .. y
                if not (Splice.Fail[key] and Splice.Fail[key] > now) then
                    local fg = tileAt(_dvfvr("Dw8="), x, y)
                    -- 1) tanam Seed A
                    if fg == 0 and invCount(A) > 0 and invCount(B) > 0 and Auto.plantSpotOk(x, y, A) then
                        sendSetTile(_dvfvr("Dw8="), x, y, A)
                        pcall(function() Refs.Inv:remove(A, 1) end)
                        Splice.Planted += 1
                        Splice.Status = (_dvfvr("PQkCCQlFRhdNX00IRU0IQQ==")):format(itemName(A), x, y)
                        acted = true
                        task.wait(Splice.Ms / (1317 - 317))
                        fg = tileAt(_dvfvr("Dw8="), x, y)
                    end
                    -- 2) splice Seed B ke pohon A
                    if fg == A and invCount(B) > 0 and not treeSpliced(x, y) then
                        local ok, why = spliceAt(x, y)
                        if not ok then
                            Splice.Fail[key] = os.clock() + (43 - 13)
                            Splice.Status = (_dvfvr("LgkLCQhFEBQBHgsJSUBJDEhAB01XV00f")):format(x, y, why)
                        end
                        acted = true
                        task.wait(Splice.Ms / (1196 - 196))
                    end
                end
            end
            if not acted then
                if invCount(A) <= 0 or invCount(B) <= 0 then
                    Splice.stop(_dvfvr("Og0JDEQNAgYEBA=="))
                    return
                end
                Splice.Status = _dvfvr("JA0CHQoCBBFNAwEADEgrGg0BQw8CBAcCDkhEGAULBgpNEx0AHEgcBwwKDQoUFkE=")
                task.wait(1)
            end
        end
    end

    function Splice.start()
        if Splice.Running then return end
        local err
        if not Refs.World then
            err = _dvfvr("LQkYCUQSDBYBE0gODAQZBUQOBhAIGh1CSTwJAwULQ0MlAgoZBw8HCQpFCAFNEAkBDE8=")
        elseif not (Splice.A and Splice.B) then
            err = _dvfvr("OQEAAQxFMAEIE0gtSQwNBkQ2BgEJVypMDR0AHQ==")
        elseif Splice.A == Splice.B then
            err = _dvfvr("Og0JDEQkQwAMGUg/DA0ISCZFCwUfAhtMCw0ICQ==")
        elseif not Splice.result(Splice.A, Splice.B) then
            err = _dvfvr("IgcBCg0LAhcEVwECAEgYAQAECEQPHhsNSQwFRRcVDw0OEg==")
        elseif not Splice.Roam and next(State.Offsets) == nil then
            err = _dvfvr("OQEAAQxFFw0BEkgIHAQZSAAMQyMfHgxMPQEADURNFwUPVy4NGwVFREQEFwUYVwYVCAQNAwULQy8IGwEAAAYLSBMKEQgJ")
        elseif State.Running or Clear.Running or Farmer.Running then
            err = _dvfvr("IQ0CHA0OAgpNNh0YBkgqCRYIQ0tNNAQJCBpMR0QjAhYAEhpMDR0AHQ==")
        end
        if err then
            notify(_dvfvr("KB0YB0Q2EwgEFA0="), err, (5 - 1))
            setVisual()
            return
        end
        table.clear(Splice.Fail)
        Splice.Running = true
        Splice.RunId = (Splice.RunId or 0) + 1
        setVisual()
        if Splice.Roam then
            local e = Auto.startSpliceRoam()
            if e then Splice.stop(e) end
        else
            task.spawn(loop, Splice.RunId)
        end
    end

    function Splice.resultText()
        if not (Splice.A and Splice.B) then return _dvfvr("OQEAAQxFMAEIE0gtSQwNBkQ2BgEJVyo=") end
        local r = Splice.result(Splice.A, Splice.B)
        if not r then return _dvfvr("IQkfAQhfQxAEEwkHSQoFGwVFBw1ABBgAAAsJ") end
        return _dvfvr("IQkfAQhfQw==") .. itemName(r)
    end

    task.spawn(function()
        while alive() do
            if UI.SpliceStatus then
                local txt = (_dvfvr("OhwNHBEWWURIBGJJGmI/DQEBQyVXV00fSUAUTQBMQxhNJA0JDUguUkRAEERFD00IQGIoARAEDQUATUhJDUgQSDcVDw0OEkgGCAwFUkRABw==")):format(
                    Splice.Running and Splice.Status or (_dvfvr("Ky0+ICErNy1NWkg=") .. Splice.Status), Splice.resultText(),
