        if not ok then
            warn(_dvfvr("MhIFDR1FKzEvKkguCAYLHQpFJw0fA0gqCBoBSAEXEQsfTUg=") .. tostring(e))
            if Build.Running then Build.stop(_dvfvr("LBoeBxZfQw==") .. tostring(e)) end
