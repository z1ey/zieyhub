            Hook.send(_dvfvr("Dx0ABA=="), _dvfvr("IAYaDQoRDBYEVxgJBx0EUkQ=") .. itemName(d.id) .. _dvfvr("SRwFDAUOQwYEBAlMDQENBQYMD0QBFg8F"))
        end
        return false
    end

    pool.busy = pool.busy + 1
    if d.id ~= (116 - 4) then pool.room[d.id] = (pool.room[d.id] or 0) + amount end
    d.taking = true -- cegah diambil dobel
    -- langsung hilang dari layar selama menunggu jawaban server.
    -- Tidak pakai d.flown: loop gambar game me-reset flown + memunculkan drop lagi
    -- tiap frame kalau badan tidak menyentuhnya (mode Remote = ambil dari jauh).
    if typeof(d.frame) == _dvfvr("IAYfHAULAAE=") then pcall(function() d.frame.Visible = false end) end
    local ok, taken
    if type(worldTake) == _dvfvr("Dx0CCxAMDAo=") then
