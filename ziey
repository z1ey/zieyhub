    if State.CollectAround then Drops.Status = Drops.Status .. _dvfvr("UkgZBhAQCEQfFgwFHBtMDxELAg8MGUgBBgwJSDYADgsZEg==") end
    local cx, cy = s.x, s.y - 0.475
