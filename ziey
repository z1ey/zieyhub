local function canBreak(id)
    if not id or id == 0 or Refs.protectedItem(id) then return false end
    local it = ItemDB[id]
    if not it then return false end
    local h = (it.kind == _dvfvr("Gg0JDA==")) and (25 - 5) or it.hits
    return h == nil or h > 0
