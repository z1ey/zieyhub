            if _lIIIlIllII[0x1]:match("%w$") then _IlIllIlIII = _IlIllIlIII .. "%f[%W]" end
            _llllllIlll[#_llllllIlll + 0x1] = { _IlIllIlIII, (_lIIIlIllII[0x2]:gsub("%%", "%%%%")), #_lIIIlIllII[0x1] }
        end
