    if err then
        notify(_dvfvr("KwkCDxELQyAEBRxMLwkeBQ=="), err, (8 - 4))
        if UI.BuildToggle then pcall(function() UI.BuildToggle:Set(false) end) end
        return
    end
    if State.Running and not State.Override then stopFarm(_dvfvr("LQEEDQoRCg8MGUgHCBoJBgVFIQUDEB0CSSwFGhBFJQUfGkgIAAUZBAUM")) end
    if Clear.Running then stopClear(_dvfvr("LQEEDQoRCg8MGUgHCBoJBgVFIQUDEB0CSSwFGhBFJQUfGkgIAAUZBAUM")) end
