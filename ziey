-- 1 langkah pabrik. o = { seed, block, drop, breakMode, whole, exclude, live, phase }
-- Hasil: "drop" | "work" | "take" | "move" | "wait" | "break" | "next" | "idle" (+ detik ke pohon siap)
local function pabrikStep(o)
    if not o.live() or not alive() then return _dvfvr("HgkFHA==") end
    local seeds, blocks = invCount(o.seed), invCount(o.block)
    o.phase = o.phase or _dvfvr("GQkCDQo=")
    Pabrik.Phase = PHASE_NAME[o.phase]
    -- drop seed lebihan (kapan saja)
    if o.drop and Pabrik.Drop and seeds >= Pabrik.DropAt and seeds > Pabrik.Keep
        and os.clock() >= (Pabrik.DropOffUntil or 0) then
        pabrikDrop(o.seed, seeds - Pabrik.Keep, o.live)
        return _dvfvr("DRoDGA==")
    end

    if o.phase ~= _dvfvr("GQkCDQo=") and Pabrik.wantHarvest(o) then
        o.phase = _dvfvr("GQkCDQo=")
        Pabrik.Phase = _dvfvr("OSkiLSo=")
        Pabrik.Status = _dvfvr("OQcEBwpFEA0MB0RMBQkCAhERQxQMGQ0C")
    end

    if o.phase == _dvfvr("GQkCDQo=") then
        -- 1x panen bisa kena beberapa pohon, jadi sisakan ruang ~20 item
        if blocks >= CAP - (25 - 5) or seeds >= CAP - (27 - 7) then
            o.phase = _dvfvr("CAUOAQg=")
            return _dvfvr("Bw0UHA==")
        end
        FC = pabrikCfg(o, true, false)
        local r = fieldStep()
        if r == _dvfvr("AAwADQ==") then
            o.readyCheckAt = 0 -- target yang baru dilewati harus dibaca ulang
            if (o.readyCount or 0) > 0 then
                -- Jalur belum tersedia: beri fase lain kesempatan, lalu cek lagi.
                o.harvestRetryAt = os.clock() + 1
                Reach = nil
            end
            o.idleAt = os.clock()
            o.phase = _dvfvr("CAUOAQg=")
            return _dvfvr("Bw0UHA==")
        end
        return r
    end

    if o.phase == _dvfvr("CAUOAQg=") then
        local r = Pabrik.takeBlocks(o)
        if r == _dvfvr("AQkeHgEWFw==") then o.phase = _dvfvr("GQkCDQo="); return _dvfvr("Bw0UHA==") end
        if r == _dvfvr("CgkCCwEJDwEJ") then return _dvfvr("HgkFHA==") end
        if r == _dvfvr("GQEPAwEB") then return _dvfvr("HQkHDQ==") end
        if r == _dvfvr("HgkFHA0LBA==") then
            waitAuto((292 - 92))
            return _dvfvr("HgkFHA==")
        end
        o.phase = _dvfvr("CxoJCQ8=")
        return _dvfvr("Bw0UHA==")
    end

    if o.phase == _dvfvr("CxoJCQ8=") then
        local want
        if o.breakMode == _dvfvr("CAQbCR0W") then
            want = blocks > 0 and seeds < CAP
        else -- mode produksi: break hanya untuk dapat seed awal
            local _, nxt = readyTreeCount(o.whole)
            want = blocks > 0 and seeds < BOOT_SEEDS and nxt == nil
        end
        if want and breakReady() then
            local ok, why = pabrikBreak(o)
            if ok then
                if why == _dvfvr("AQkeHgEWFw==") then
                    o.phase = _dvfvr("GQkCDQo=")
                    return _dvfvr("Bw0UHA==")
                end
                o.phase = _dvfvr("HQkCCQk=")
                return _dvfvr("CxoJCQ8=")
            end
        end
        o.phase = _dvfvr("HQkCCQk=")
        return _dvfvr("Bw0UHA==")
    end

    if o.phase == _dvfvr("HQkCCQk=") then
        if seeds > 0 then
            FC = pabrikCfg(o, false, true)
            local r = fieldStep()
            if r == _dvfvr("AQkeHgEWFw==") then o.phase = _dvfvr("GQkCDQo="); return _dvfvr("Bw0UHA==") end
            if r ~= _dvfvr("AAwADQ==") then return r end
        end
        o.plantAt = os.clock()
        o.takeCheckAt = os.clock() + 1
        o.phase = _dvfvr("HR0CDwMQ")
        return _dvfvr("Bw0UHA==")
    end

    -- tunggu
    local n, nxt = readyTreeCount(o.whole)
    if o.breakMode == _dvfvr("CAQbCR0W") and blocks > 0 and seeds < CAP and breakReady() then
        o.phase = _dvfvr("CAUOAQg=")
        return _dvfvr("Bw0UHA==")
    end
    if (seeds > 0 and os.clock() - (o.plantAt or 0) > (17 - 7))
        or (blocks < CAP and os.clock() >= (o.takeCheckAt or 0)) then
        -- Drop block yang masih di world diperiksa sebelum break / tanam lagi.
        o.takeCheckAt = os.clock() + 1
        o.phase = _dvfvr("CAUOAQg=")
        return _dvfvr("Bw0UHA==")
    end
    return _dvfvr("AAwADQ=="), nxt, n
end

