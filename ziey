            if _lllIIIlIIl[1]:match("%w$") then _IIlIIllIlI = _IIlIIllIlI .. "%f[%W]" end
            _llIlIllIII[#_llIlIllIII + 1] = { _IIlIIllIlI, (_lllIIIlIIl[2]:gsub("%%", "%%%%")), #_lllIIIlIIl[1] }
        end
    end
    table.sort(_llIlIllIII, function(_lIIIllIlII, _IllIllIIII) return _lIIIllIlII[3] > _IllIllIIII[3] end)
