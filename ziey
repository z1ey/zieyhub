-- Game abaikan pukulan ke tile yang baru di-place (< 0.3 detik)
local PLACE_GUARD = 0.32

-- Place 1 tile kalau kosong. Hasil: "place" / "habis" / nil
local function tryPlace(x, y)
    local sel = farmBlock()
    if not sel then return nil end
    local fg = tileAt(_dvfvr("Dw8="), x, y)
    if fg == nil then return nil end
    local bg = tileAt(_dvfvr("Cw8="), x, y)
    local it = ItemDB[sel]
    local layer = (it and it.background) and _dvfvr("Cw8=") or _dvfvr("Dw8=")
    local cur = (layer == _dvfvr("Cw8=")) and bg or fg
    if not (cur == 0 and (layer == _dvfvr("Cw8=") or fg == 0)) then return nil end
    if invCount(sel) <= 0 then return _dvfvr("AQkOARc=") end

    sendSetTile(layer, x, y, sel)
    if Refs.Inv then pcall(function() Refs.Inv:remove(sel, 1) end) end
    local key = x .. _dvfvr("RQ==") .. y
    HitCount[key] = nil
    PlacedAt[key] = os.clock()
    State.Placed += 1
    State.LastAction = _dvfvr("OQQNCwFF") .. itemName(sel) .. _dvfvr("SUA=") .. x .. _dvfvr("RQ==") .. y .. _dvfvr("QA==")
    return _dvfvr("GQQNCwE=")
end

-- Masih ada yang bisa dipecah di tile ini? (block depan / background)
local function breakableAt(x, y)
    local fg = tileAt(_dvfvr("Dw8="), x, y)
    if fg == nil then return false end
    if fg ~= 0 then return canBreak(fg) end
    local bg = tileAt(_dvfvr("Cw8="), x, y)
    return State.BreakBackground and bg ~= nil and bg ~= 0 and canBreak(bg)
end

-- Pukul 1 kali. Hasil: "hit" / "broke" / nil
-- includeBg = ikut pecah background
local function tryBreak(x, y, includeBg, nativeOnly, settle)
    if includeBg == nil then includeBg = State.BreakBackground end
    local world, grid = Refs.World, Refs.World and Refs.World.fg
    local key = x .. _dvfvr("RQ==") .. y
    local fg = tileAt(_dvfvr("Dw8="), x, y)
    if fg == nil then return nil end
    local bg = tileAt(_dvfvr("Cw8="), x, y)
    local layer, id
    if fg ~= 0 then
        layer, id = _dvfvr("Dw8="), fg
    elseif includeBg and bg ~= 0 then
        layer, id = _dvfvr("Cw8="), bg
    end
    if not layer or not canBreak(id) then return nil end
    local spawn = world and world.spawn
    if spawn and x == spawn.X and y == spawn.Y then return nil, _dvfvr("GRoDHAEGFwEJ") end

    -- tunggu sebentar kalau tile baru di-place
    local t = PlacedAt[key]
    if t then
        local age = os.clock() - t
        if age < PLACE_GUARD then task.wait(PLACE_GUARD - age) end
        PlacedAt[key] = nil
    end

    if Refs.World ~= world or not world or world.fg ~= grid then return nil, _dvfvr("HgceBABIAAwMGQ8JDQ==") end
    -- Clear harus memilih ulang kalau isi tile berubah saat menunggu pijakan.
    if nativeOnly and (tileAt(_dvfvr("Dw8="), x, y) ~= fg or tileAt(layer, x, y) ~= id) then
        return nil, _dvfvr("HQEADUkGCwUDEA0I")
    end

    if type(Refs.Punch) == _dvfvr("Dx0CCxAMDAo=") then
        local ok, err = pcall(Refs.Punch, x, y, State.MutePunch or nil, nil)
        if not ok then
            State.LastAction = _dvfvr("LBoeBxZFExEGAgRWSQ==") .. tostring(err)
            return nil, _dvfvr("GR0CCwxIBhYfGBo=")
        end
        if settle and tileAt(layer, x, y) == id then
            local untilAt = os.clock() + settle
            while alive() and Refs.World == world and world.fg == grid
                and tileAt(layer, x, y) == id and os.clock() < untilAt do task.wait(0.02) end
        end
        if Refs.World ~= world or world.fg ~= grid then return nil, _dvfvr("HgceBABIAAwMGQ8JDQ==") end
        if State.Visual then Anim.swing(x, y, _dvfvr("GR0CCww=")) end
        if tileAt(layer, x, y) ~= id then
            Drops.brokeAt[key] = os.clock()
            State.Broken += 1
            State.LastAction = _dvfvr("KxoJCQ9F") .. itemName(id) .. _dvfvr("SUA=") .. x .. _dvfvr("RQ==") .. y .. _dvfvr("QA==")
            return _dvfvr("CxoDAwE=")
        end
        State.LastAction = _dvfvr("OR0HHQhF") .. itemName(id) .. _dvfvr("SUA=") .. x .. _dvfvr("RQ==") .. y .. _dvfvr("QA==")
        return _dvfvr("AQEY")
    end

    if nativeOnly then
        State.LastAction = _dvfvr("Lx0CDxcMQxQYHB0ASQ8NBQFFFwEfBx0YHBs=")
        return nil, _dvfvr("BwkYARIATgkEBBsFBw8=")
    end

    -- Cadangan: hitung pukulan sendiri
    local hc = HitCount[key]
    if not hc or hc.id ~= id or hc.layer ~= layer then
        hc = { id = id, layer = layer, n = 0 }
        HitCount[key] = hc
    end
    hc.n += 1
    sendHitFx(x, y)
    if State.Visual then Anim.swing(x, y, _dvfvr("GR0CCww=")) end
    local need = hitsNeeded(id)
    if hc.n >= need then
        sendSetTile(layer, x, y, 0)
        HitCount[key] = nil
        Drops.brokeAt[key] = os.clock()
        State.Broken += 1
        State.LastAction = _dvfvr("KxoJCQ9F") .. itemName(id) .. _dvfvr("SUA=") .. x .. _dvfvr("RQ==") .. y .. _dvfvr("QA==")
        return _dvfvr("CxoDAwE=")
    end
    State.LastAction = _dvfvr("OR0HHQhF") .. itemName(id) .. _dvfvr("SQ==") .. hc.n .. _dvfvr("Rg==") .. need
    return _dvfvr("AQEY")
end

